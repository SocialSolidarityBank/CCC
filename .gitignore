# 에이전트 런타임 상태 (커밋 금지, 예외: .omc/skills/)
.omc/*
!.omc/skills/
.omo/
.gjc/
.cockpit/

# 의존성·빌드 산출물 (추후 Next.js/Workers 셋업 대비)
node_modules/
.next/
.wrangler/
.open-next/
dist/
*.tsbuildinfo

# 환경 변수·시크릿
.env
.env.*
.dev.vars

# OS
.DS_Store

# 에이전트 런타임 상태 (하위 디렉터리 포함)
**/.omc/

# Python (apps/pipeline)
__pycache__/
*.pyc

# 시드 툴 산출물(생성물 — 커밋 금지)
scripts/seed/out/

# 로컬 도구 산출물
.playwright-mcp/

# 병렬 작업용 워크트리 — 등록된 워크트리는 git이 이미 무시하지만,
# 등록이 풀린 잔여 폴더가 add -A 로 딸려 들어오는 사고를 막는 가드다.
# (2026-07-30: 7개 8.6 GB / 폴더당 파일 약 4만 — 실수로 커밋되면 되돌리기 비싸다)
.worktrees/

# 스킨 패스 렌더 증거(전체 스윕) — 용량이 커서 커밋하지 않는다.
# 재생성: scripts/design/shots.py (절차는 artifacts/design-system-v0.1-skin/README.md)
artifacts/skin-shots/

# 세션 산출물(핸드오프·리포트) — 로컬 작업 메모라 커밋하지 않는다.
# 2026-07-28 전환 때 이 디렉터리는 실 이메일·로컬 경로 때문에 스냅샷에서 제외됐고,
# add -A 로 되돌아오는 사고를 막으려면 문서 규칙이 아니라 여기서 막아야 한다.
docs/handoffs/
omp-session-*.html
