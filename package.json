{
  "name": "ccc",
  "version": "0.3.2",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm --filter @ccc/api run build && pnpm --filter @ccc/web run build",
    "typecheck": "pnpm --filter @ccc/api run typecheck && pnpm --filter @ccc/web run typecheck",
    "test": "pnpm run test:design-routes && pnpm --filter @ccc/api run test && pnpm --filter @ccc/web run test && pnpm run design:routes",
    "test:design-routes": "node --test scripts/design/route-inventory.test.mjs && python3 -m unittest scripts/design/ia_shots_test.py",
    "design:routes": "python3 scripts/design/shots.py --check-inventory",
    "design:sweep": "python3 scripts/design/shots.py --check-capture ac3-permission-aware-sweep",
    "design:sweep:capture": "python3 scripts/design/ia-shots.py ac3-six-matrix",
    "design:sweep:verify": "python3 scripts/design/ia-shots.py --verify-report artifacts/ia-shots/ac3-six-matrix/report.json",
    "guard:db": "node scripts/guard-db-gateway.mjs",
    "guard:doc-numbers": "node scripts/guard-doc-numbers.mjs",
    "guard:consent-copy": "pnpm --filter @ccc/web exec vitest run app/participants/new/consent-copy.test.ts",
    "guard:tokens": "node scripts/design/token-audit.mjs",
    "guard:align": "node scripts/design/align-audit.mjs",
    "guard:hierarchy": "node scripts/design/hierarchy-audit.mjs",
    "guard:hierarchy:test": "node scripts/design/hierarchy-audit.test.mjs",
    "guard:hierarchy:baseline": "node scripts/design/hierarchy-audit.mjs --update-baseline",
    "design:hierarchy": "pnpm --filter @ccc/web exec vitest run app/kit/hierarchy-harness.test.tsx && ${HIERARCHY_PYTHON:-python3} scripts/design/hierarchy-measure.py",
    "design:contrast": "node scripts/design/contrast.mjs",
    "guard:secrets": "node scripts/guard-secrets.mjs",
    "guard:secrets:history": "node scripts/guard-secrets.mjs --history",
    "guard:secrets:allowlist": "node scripts/guard-secrets-allowlist.test.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "guard:deploy-verdict": "node scripts/deploy-verdict.test.mjs",
    "guard:deploy-gates": "node scripts/deploy-gates.test.mjs",
    "deploy:production:check": "node scripts/deploy-production.mjs --preflight-only",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "seed:reschedule": "node scripts/seed/reschedule-upcoming.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@cloudflare/workers-types": "^5.20260706.1",
    "@types/node": "^24.0.0",
    "miniflare": "^4.20260702.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.107.0"
  }
}
