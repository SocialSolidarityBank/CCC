{
  "name": "@ccc/api",
  "version": "0.5.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@ccc/ai-runtime": "workspace:*",
    "@ccc/audio-r2": "workspace:*",
    "@ccc/identity-access": "workspace:*",
    "@ccc/core": "workspace:*",
    "@ccc/db-d1": "workspace:*",
    "@ccc/http-api": "workspace:*"
  },
  "devDependencies": {
    "@ccc/contracts": "workspace:*",
    "@ccc/db-sqlite": "workspace:*"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit --project apps/api/tsconfig.json",
    "eval:flags": "node --disable-warning=ExperimentalWarning --experimental-transform-types eval/run-flag-eval.ts",
    "build": "pnpm --workspace-root exec tsc --noEmit --project apps/api/tsconfig.json",
    "test": "pnpm --workspace-root exec vitest run --config apps/api/vitest.config.ts --maxWorkers=4"
  }
}
