[
  {
    "name": "AI 제안 라벨과 안내 문구는 같은 행 세로 중앙",
    "selectors": [
      "#align-content .wire-card-section-head:has(>.briefing-ai-goal-hint)>h3",
      "#align-content .briefing-ai-goal-hint"
