      "#align-content #briefing-remember .wire-card-section[data-tone=\"lavender\"]>.wire-card-section-head",
      "#align-content #briefing-remember .wire-card-section[data-tone=\"lavender\"]>.briefing-suggestions",
      "#align-content #briefing-remember .wire-card-section[data-tone=\"mint\"]>h3",
      "#align-content #briefing-remember .wire-card-section[data-tone=\"mint\"]>.empty"
    ],
    "axis": "gap-pair",
    "tolerance": 1
  },
  {
    "name": "세부 목표 불릿 점은 첫 줄 세로 중앙",
